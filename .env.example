# === BACKEND FIREBASE CONFIGURATION ===
PORT=5000
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project-id.iam.gserviceaccount.com
# Use \n instead of actual newlines in private key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQ...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# OR you can pass the service account JSON as a single line string
# FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "...", ...}'

# === FRONTEND VITE FIREBASE CONFIGURATION ===
VITE_FIREBASE_API_KEY=AIzaSyA1...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# === SECURITY (REQUIRED — the server refuses to start without these) ===
# Generate both with: node backend/scripts/hashPassword.js "your-password"
ADMIN_PASSWORD_HASH=$2a$12$replace_me_with_a_real_bcrypt_hash
JWT_SECRET=replace_me_with_64_random_hex_chars

# Owner phone for the two-factor login code (WhatsApp). Leave empty to disable 2FA.
OWNER_PHONE_NUMBER=9647701234567

# Emergency only: allows login without the OTP when WhatsApp is down.
# Keep it false in normal operation.
ALLOW_LOGIN_WITHOUT_OTP=false

# Encrypts the daily backup. Without it the backup travels as plain text —
# every customer, phone number and balance in one forwardable file.
# Use 20+ random characters, and store it somewhere OTHER than the backups.
# If this is lost the backups cannot be opened by anyone.
BACKUP_PASSPHRASE=

# Origins allowed to call the API. The frontend is served by this same server,
# so this normally stays empty. Comma-separated, no trailing slash.
ALLOWED_ORIGINS=
